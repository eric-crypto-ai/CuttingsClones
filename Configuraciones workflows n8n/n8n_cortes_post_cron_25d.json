      "parameters": {
        "jsCode": "const body = $('Webhook Crear Corte').first().json.body;\nconst filas = $input.all().map(i => i.json);\n\nconst fecha_corte = String(body.fecha_corte || '').trim();\nconst genetica = String(body.genetica || '').trim();\nconst num_esquejes = parseInt(body.num_esquejes, 10);\nconst intervalo_dias = parseInt(body.intervalo_dias, 10) || 14;\nconst operario = String(body.operario || '').trim();\nconst observaciones = String(body.observaciones || '').trim();\n\nif (!fecha_corte) throw new Error('falta fecha_corte');\nif (!genetica) throw new Error('falta genetica');\nif (!num_esquejes || num_esquejes <= 0) throw new Error('num_esquejes invalido');\n\nconst prefixMap = { 'Amnesia': 'AMN', 'Hokuzai': 'HOK' };\nconst prefix = prefixMap[genetica] || genetica.slice(0, 3).toUpperCase();\n\n// Secuencial del dia para misma genetica\nconst mismoDia = filas.filter(f =>\n  String(f.fecha_corte || '').trim() === fecha_corte &&\n  String(f.genetica || '').trim() === genetica\n);\nconst secuencial = mismoDia.length + 1;\nconst id_evento = prefix + '-' + fecha_corte + '-' + secuencial;\n\n// Fecha proximo corte = fecha_corte + intervalo_dias\nconst d = new Date(fecha_corte + 'T00:00:00Z');\nd.setUTCDate(d.getUTCDate() + intervalo_dias);\nconst fecha_proximo = d.getUTCFullYear() + '-' +\n  String(d.getUTCMonth() + 1).padStart(2, '0') + '-' +\n  String(d.getUTCDate()).padStart(2, '0');\n\nreturn [{\n  json: {\n    id_evento,\n    fecha_corte,\n    genetica,\n    num_esquejes,\n    intervalo_dias,\n    fecha_proximo_corte_estimada: fecha_proximo,\n    operario,\n    observaciones,\n    estado: 'activo'\n  }\n}];"
      },
